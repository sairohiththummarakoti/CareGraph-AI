digraph "05_shared_state_lifecycle" {
	bgcolor=white dpi=180 nodesep=.35 outputorder=edgesfirst pad=.27 rankdir=TB ranksep=.68 splines=spline
	node [color="#88A6BC" fillcolor="#EAF3FF" fontcolor="#17324D" fontname="DejaVu Sans" fontsize=12 margin=".22,.15" penwidth=1.3 shape=box style="rounded,filled"]
	edge [arrowsize=.7 color="#0B777E" fontcolor="#17324D" fontname="DejaVu Sans" fontsize=10 penwidth=1.5]
	s0 [label="STATE 0 — After user input
question = “How do cancer and heart history affect review?”" fillcolor="#EAF3FF"]
	s1 [label="STATE 1 — After coordinator
domains = [oncology, cardiology]" fillcolor="#EAF3FF"]
	s2 [label="STATE 2 — After retrieval
oncology_chunks = 5 · cardiology_chunks = 4" fillcolor="#E6F6F1"]
	s3 [label="STATE 3 — After synthesis
draft_answer + source citations" fillcolor="#E6F6F1"]
	s4 [label="STATE 4 — After assurance
decision = release / revise / escalate / block" fillcolor="#FFF2DB"]
	s0 -> s1 [label="node returns state update"]
	s1 -> s2 [label="node returns state update"]
	s2 -> s3 [label="node returns state update"]
	s3 -> s4 [label="node returns state update"]
	note [label="OpenSearch / FAISS is NOT shared state
Vector index holds preprocessed knowledge" fillcolor="#FCEDEF"]
	note -> s2 [label="retrieval supplies evidence" style=dashed]
}
