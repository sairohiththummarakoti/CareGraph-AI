# Runtime is local and offline after ingestion caches the pinned model.
# No API key is needed. This template is documentation; set variables explicitly
# in your shell. Never put real patient data in this demonstration.
#
# Optional cloud tracing requires BOTH application-specific switches.
# CAREGRAPH_CLOUD_TRACING=false
# CAREGRAPH_SYNTHETIC_DATA_CONFIRMED=false
# Set both to exactly 1 to opt in. Other values leave tracing disabled.
# LANGSMITH_API_KEY=
# Redacted metadata is exported to the caregraph-synthetic project.
